<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="720.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.biblioteca.controller.MainController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label text="Registro de préstamos" style="-fx-font-weight: bold; -fx-font-size: 16;" />
      <GridPane hgap="10.0" vgap="6.0">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="260.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <Label text="Socio" GridPane.rowIndex="1" />
            <Label text="Plazo (días)" GridPane.rowIndex="2" />
            <Label text="Materiales" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbTipo" prefWidth="150.0" GridPane.columnIndex="1" />
            <TextField fx:id="txtSocio" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtDias" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtMateriales" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox fx:id="boxLibro" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Título del libro" />
            <TextField fx:id="txtTitulo" prefWidth="240.0" />
            <CheckBox fx:id="chkNovedad" mnemonicParsing="false" text="Novedad" />
            <CheckBox fx:id="chkRenovado" mnemonicParsing="false" text="Ya renovado" />
         </children>
      </HBox>
      <HBox fx:id="boxAudiovisual" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Formato" />
            <TextField fx:id="txtFormato" prefWidth="140.0" />
            <Label text="Duración (minutos)" />
            <TextField fx:id="txtDuracion" prefWidth="80.0" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
      <Separator />
      <TableView fx:id="tblPrestamos" prefHeight="300.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
          <TableColumn fx:id="colSocio" prefWidth="75.0" text="Socio" />
          <TableColumn fx:id="colDias" prefWidth="75.0" text="Días" />
          <TableColumn fx:id="colMateriales" prefWidth="75.0" text="Materiales" />
          <TableColumn fx:id="colTarifa" prefWidth="75.0" text="Tarifa" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
      <Separator />
      <Label fx:id="lblMensaje" wrapText="true" />
   </children>
</VBox>
