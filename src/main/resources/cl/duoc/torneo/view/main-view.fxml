<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="720.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.torneo.controller.MainController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <GridPane>
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <Label text="Nombre" GridPane.rowIndex="1" />
            <Label text="Partidos jugados" GridPane.rowIndex="2" />
            <Label text="Rondas" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbTipo" prefWidth="150.0" GridPane.columnIndex="1" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtPartidos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtRondas" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox fx:id="boxEquipo" spacing="10.0">
         <children>
            <Label text="Capitán" />
            <TextField fx:id="txtCapitan" />
            <CheckBox fx:id="chkCanchaTechada" mnemonicParsing="false" text="Cancha techada" />
         </children>
      </HBox>
      <HBox fx:id="boxIndividual" spacing="10.0">
         <children>
            <Label text="Ranking" />
            <TextField fx:id="txtRanking" prefWidth="80.0" />
            <Label text="Años federado" />
            <TextField fx:id="txtAniosFederado" prefWidth="80.0" />
            <CheckBox fx:id="chkBecado" mnemonicParsing="false" text="Becado" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
      <TableView fx:id="tblInscripciones" prefHeight="300.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
          <TableColumn fx:id="colPartidos" prefWidth="75.0" text="Partidos jugados" />
          <TableColumn fx:id="colRondas" prefWidth="75.0" text="Rondas" />
          <TableColumn fx:id="colCuota" prefWidth="75.0" text="Cuota de inscripción" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
      <Label fx:id="lblMensaje" wrapText="true" />
   </children>
</VBox>
