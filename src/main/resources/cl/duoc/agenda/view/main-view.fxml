<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="720.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.agenda.controller.MainController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold;" text="Registro de compromiso" />
      <GridPane hgap="10.0" vgap="5.0">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <Label text="Título" GridPane.rowIndex="1" />
            <Label text="Duración (min)" GridPane.rowIndex="2" />
            <Label text="Asistentes" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbTipo" prefWidth="150.0" GridPane.columnIndex="1" />
            <TextField fx:id="txtTitulo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtDuracion" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtAsistentes" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox fx:id="boxReunion" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Organizador" />
            <TextField fx:id="txtOrganizador" />
            <CheckBox fx:id="chkVirtual" mnemonicParsing="false" text="Virtual" />
         </children>
      </HBox>
      <HBox fx:id="boxEvento" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Lugar" />
            <TextField fx:id="txtLugar" />
            <Label text="Anticipación (días)" />
            <TextField fx:id="txtAnticipacion" prefWidth="80.0" />
            <CheckBox fx:id="chkConfirmado" mnemonicParsing="false" text="Confirmado" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Compromisos registrados" />
      <TableView fx:id="tblCompromisos" prefHeight="300.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
          <TableColumn fx:id="colTitulo" prefWidth="75.0" text="Título" />
          <TableColumn fx:id="colDuracion" prefWidth="75.0" text="Duración (min)" />
          <TableColumn fx:id="colAsistentes" prefWidth="75.0" text="Asistentes" />
          <TableColumn fx:id="colCosto" prefWidth="75.0" text="Costo por asistente" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Mensajes" />
      <Label fx:id="lblMensaje" wrapText="true" />
   </children>
</VBox>
