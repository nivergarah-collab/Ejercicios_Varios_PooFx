<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="760.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.playlist.controller.MainController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold;" text="Registro de pista" />
      <GridPane hgap="10.0" vgap="5.0">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo" />
            <Label text="Título" GridPane.rowIndex="1" />
            <Label text="Artista" GridPane.rowIndex="2" />
            <Label text="Duración (min)" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbTipo" prefWidth="150.0" GridPane.columnIndex="1" />
            <TextField fx:id="txtTitulo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtArtista" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtDuracion" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox fx:id="boxCancion" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Álbum" />
            <TextField fx:id="txtAlbum" />
            <CheckBox fx:id="chkEstreno" mnemonicParsing="false" text="Estreno" />
         </children>
      </HBox>
      <HBox fx:id="boxPodcast" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="N° de episodio" />
            <TextField fx:id="txtEpisodio" prefWidth="80.0" />
            <CheckBox fx:id="chkSincronizado" mnemonicParsing="false" text="Sincronizado" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Pistas registradas" />
      <TableView fx:id="tblPistas" prefHeight="300.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
          <TableColumn fx:id="colTitulo" prefWidth="75.0" text="Título" />
          <TableColumn fx:id="colArtista" prefWidth="75.0" text="Artista" />
          <TableColumn fx:id="colDuracion" prefWidth="75.0" text="Duración (min)" />
          <TableColumn fx:id="colLicencia" prefWidth="75.0" text="Licencia" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Mensajes" />
      <Label fx:id="lblMensaje" wrapText="true" />
   </children>
</VBox>
